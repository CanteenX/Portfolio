# ── Public website (next dev -p 4000) ────────────────────────────────────────
#
# In production this is NOT set: the site is served from the same origin as the
# API, so lib/api.ts falls back to an empty baseURL and every request is
# relative (/api/v1/...). The rewrites below forward those to the backend.
#
# Locally there is no rewrite, so point the browser straight at the backend.
NEXT_PUBLIC_API_URL=http://localhost:7002

# Canonical origin used for metadata, canonical URLs, sitemap.xml and robots.txt.
# Defaults to https://umaeng.co.in; override for a preview that should describe
# itself rather than production.
# NEXT_PUBLIC_SITE_URL=

# ── Rewrite targets (PRODUCTION-CRITICAL) ────────────────────────────────────
#
# Read only by next.config.ts. The entire production topology depends on these:
# this Next app reverse-proxies the other two Vercel projects through the single
# umaeng.co.in origin. Each rewrite block is guarded by `if (ORIGIN)`, so an
# unset variable does not fail the build — /api/* or /admin simply 404s in
# production with no error and no log line.
#
# Set BOTH on the Vercel "portfolio" project, for Production and Preview.
#   API_PROXY_ORIGIN   -> the portfolio-server deployment
#   ADMIN_PROXY_ORIGIN -> the portfolio-admin deployment
#
# Left unset locally so dev talks to localhost:7002 directly instead of
# proxying to the deployed backend.
# API_PROXY_ORIGIN=https://server.nventra.umaeng.co.in
# ADMIN_PROXY_ORIGIN=https://admin.nventra.umaeng.co.in
